// The peers relay: one Cloudflare Worker and one Durable Object that holds
// every connected player's socket, passes each one's position to the rest, and
// keeps who sits in which vehicle and where each was left.
// Deployed on its own (`pnpm peers:deploy`); Vercel serves the world and knows
// this only as `VITE_PEERS_URL`.
{
  "name": "atlas-peers",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  // The free plan only runs SQLite-backed Durable Objects, so the class is
  // declared as one; the room keeps where vehicles were left in its storage.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "observability": { "enabled": true }
}
