{
  "name": "atlas",
  "private": true,
  "description": "An explorer of Earth: a walkable planet holding the world's notable landmarks, on foot and by boat and plane.",
  "license": "MIT",
  "author": "Andreu Massanet",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreumassanet/atlas.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "sources": "node scripts/fetch-sources.mjs",
    "data": "node scripts/build-countries.mjs",
    "monuments": "node scripts/build-monuments.ts",
    "places": "node scripts/build-places.mjs",
    "lakes": "node scripts/build-lakes.mjs",
    "roads": "node scripts/build-roads.ts",
    "facts": "node scripts/build-country-info.mjs",
    "check": "node scripts/check-world.ts",
    "people": "node scripts/check-people.ts",
    "cast": "node scripts/build-cast.mjs",
    "kit": "node scripts/build-kit.ts",
    "audio": "node scripts/build-audio.mjs",
    "life": "node scripts/check-life.ts",
    "fauna": "node scripts/check-fauna.ts",
    "system": "node scripts/check-system.ts",
    "traffic": "node scripts/check-traffic.ts",
    "craft": "node scripts/check-craft.ts",
    "effects": "node scripts/check-effects.ts",
    "weather": "node scripts/check-weather.ts",
    "ambient": "node scripts/check-ambient.ts",
    "sea": "node scripts/check-sea.ts",
    "passport": "node scripts/check-passport.ts",
    "fleet": "node scripts/check-fleet.ts",
    "ground": "node scripts/check-ground.ts",
    "country": "node scripts/check-country.ts",
    "scenery": "node scripts/check-scenery.ts",
    "solids": "node scripts/check-solids.ts",
    "interiors": "node scripts/check-interiors.ts",
    "input": "node scripts/check-input.ts",
    "chat": "node scripts/check-chat.ts",
    "music": "node scripts/check-music.ts",
    "perf": "node scripts/check-perf.ts",
    "ui": "node scripts/check-ui.mjs",
    "shot": "node scripts/check-shot.mjs",
    "graphics": "node scripts/check-graphics.mjs",
    "browser": "pnpm shot && pnpm ui && pnpm graphics",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "peers": "npx -y wrangler@4 dev --config server/wrangler.jsonc",
    "relay": "node scripts/check-relay.ts",
    "peers:deploy": "npx -y wrangler@4 deploy --config server/wrangler.jsonc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json && tsc --noEmit -p server/tsconfig.json"
  },
  "dependencies": {
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/three": "^0.182.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
